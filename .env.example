# Create a Service App in emma Project → Settings → Service Apps.
# Use Manage scope for provisioning; these values must remain server-side.
EMMA_CLIENT_ID=
EMMA_CLIENT_SECRET=
# Or provide a short-lived token for testing. Client ID + secret is preferred.
# EMMA_TOKEN=

# HMAC signer for exact, short-lived search plans. In live mode, the server can fall back to
# EMMA_CLIENT_SECRET, but a distinct random value is recommended. Generate with: openssl rand -base64 36
PLAN_SIGNING_SECRET=

# Required whenever live emma credentials are configured. Leave blank to keep live routes locked.
APP_PASSWORD=
APP_SESSION_SECRET=
